      "name": "01. GET /books - All Books (Default)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books"]
        }
      }
    },
    {
      "name": "02. GET /books - Title Search (search_q=Harry)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books?search_q=Harry",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books"],
          "query": [
            { "key": "search_q", "value": "Harry" }
          ]
        }
      }
    },
    {
      "name": "03. GET /books - Price Filter & Sort (min_price=300&max_price=550&order_by=price&order=ASC)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books?min_price=300&max_price=550&order_by=price&order=ASC",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books"],
          "query": [
            { "key": "min_price", "value": "300" },
            { "key": "max_price", "value": "550" },
            { "key": "order_by", "value": "price" },
            { "key": "order", "value": "ASC" }
          ]
        }
      }
    },
